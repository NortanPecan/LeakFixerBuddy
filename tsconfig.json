{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,

    // ── Strict mode (full) ─────────────────────────────────
    // `strict: true` enables: strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization,
    // noImplicitAny, noImplicitThis, alwaysStrict, useUnknownInCatchVariables
    "strict": true,

    // Additional strict checks beyond `strict: true`
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false, // TODO: enable after fixing existing errors
    "exactOptionalPropertyTypes": false, // TODO: enable after fixing existing errors

    // ── Module ─────────────────────────────────────────────
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    // ── Build ──────────────────────────────────────────────
    "incremental": true,

    // ── Plugins ────────────────────────────────────────────
    "plugins": [{ "name": "next" }],

    // ── Paths ──────────────────────────────────────────────
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "examples/**", "skills/**", "src/lib/leak-policy.test.ts"]
}
