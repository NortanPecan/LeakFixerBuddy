# ============================================================
# LeakFixer Buddy — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control!
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Public vars (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (Supabase PostgreSQL via Prisma) ────────────────
# Pooling URL for queries (port 6543)
DATABASE_URL="postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct URL for migrations (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# ── Telegram ─────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-example_token

# Secret token for webhook verification (≥16 chars, random string)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string-16-chars-min

# ── Authentication ───────────────────────────────────────────
# HMAC-SHA256 signing secret for session cookies (≥32 chars)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-32-chars-min

# ── AI Providers ─────────────────────────────────────────────
# Primary AI: Groq — get key at https://console.groq.com
GROQ_API_KEY=gsk_replace-with-your-groq-api-key

# Fallback AI: Google Gemini — get key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_replace-with-your-gemini-api-key

# ── Sentry (error tracking) ──────────────────────────────────
# Optional: get at https://sentry.io — create a Next.js project
# NEXT_PUBLIC_SENTRY_DSN is visible in the browser (safe — it's a data endpoint, not a secret)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-only DSN (same value, just not exposed to browser)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# For uploading source maps during build
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=leakfixer-buddy
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Upstash Redis (rate limiting) ───────────────────────────
# Optional: if not set, falls back to in-memory rate limiting (not recommended for production)
# Get at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ── Cron / Scheduled Jobs ────────────────────────────────────
# Bearer token protecting /api/telegram/notify and other cron endpoints
CRON_SECRET=replace-with-random-cron-secret-32-chars-min
