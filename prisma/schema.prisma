// FINANCE MODULE
// ============================================

/// Financial account (cash, card, poker bankroll, etc.)
model Account {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   // "Карта Тинькофф", "Наличные", "Банкролл покер"
  type           String   @default("cash") // cash, card, poker, steam, other
  currency       String   @default("RUB") // RUB, USD, EUR, KZT, UZS, etc.
  initialBalance Float    @default(0) @map("initial_balance") // Starting balance
  icon           String?  // Emoji or icon name
  color          String?  // Hex color
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
}

/// Finance category (envelope/budget category)
model Category {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   // "Steam/связки", "LeakFixer", "ИИ/подписки"
  zone          String   @default("general") // steam, leakfixer, ai, poker, health, life, savings, general
  monthlyTarget Float?   @map("monthly_target") // Desired monthly budget (optional)
  icon          String?  // Emoji or icon name
  color         String?  // Hex color
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
}

/// Financial transaction
model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid // Optional - can be uncategorized
  date        DateTime @default(now()) @db.Timestamptz
  amount      Float    // Positive = income, Negative = expense
  description String?  // Comment/note
  zone        String?  // Can be derived from category or set manually
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user     AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

