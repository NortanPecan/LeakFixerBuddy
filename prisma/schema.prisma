  @@unique([userId, year, week])
  @@map("weekly_wellbeing")
}

// ============================================
// JOURNEY COURSE MODULE - 30-Day Interactive Course
// ============================================

/// Journey lesson definition (30 lessons)
model JourneyLesson {
  id          String   @id @default(uuid()) @db.Uuid
  day         Int      @unique // 1-30
  week        Int      // 1-4
  weekName    String   @map("week_name") // "Пробуждение", "Закалка", etc.
  title       String
  story       String?  @db.Text // Story/introduction text
  tasks       String   @db.Text // JSON array of tasks
  quote       String?  @db.Text // Motivational quote
  tip         String?  @db.Text // Tip of the day
  rewardXp    Int      @default(0) @map("reward_xp")
  achievement String?  // Achievement code if completing this day unlocks one
  unlocks     String?  // JSON array of features to unlock: ["habits", "water"]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("journey_lessons")
}

/// User's journey progress
model JourneyProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  currentDay   Int       @default(1) @map("current_day") // 1-30
  goal         String?   // User's main goal: "fitness", "productivity", "health", "finance", "all"
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz
  totalXp      Int       @default(0) @map("total_xp")
  streak       Int       @default(0) // Consecutive days completed
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      JourneyTask[]
  unlocks    JourneyUnlock[]
  achievements JourneyAchievement[]
  reflections JourneyReflection[]

  @@map("journey_progress")
}

/// Task completion tracking
model JourneyTask {
  id           String   @id @default(uuid()) @db.Uuid
  progressId   String   @map("progress_id") @db.Uuid
  day          Int      // 1-30
  taskId       String   // Task identifier within the day
  completed    Boolean  @default(false)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  xpEarned     Int      @default(0) @map("xp_earned")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  progress JourneyProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, day, taskId])
  @@map("journey_tasks")
}

/// Feature unlock tracking
model JourneyUnlock {
  id          String   @id @default(uuid()) @db.Uuid
  progressId  String   @map("progress_id") @db.Uuid
  feature     String   // Feature name: "habits", "water", "gym", etc.
  unlockedAt  DateTime @default(now()) @map("unlocked_at") @db.Timestamptz

  progress JourneyProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, feature])
  @@map("journey_unlocks")
}

/// Journey achievements
model JourneyAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  progressId  String   @map("progress_id") @db.Uuid
  code        String   // Achievement code: "first_step", "week_streak", etc.
  earnedAt    DateTime @default(now()) @map("earned_at") @db.Timestamptz

  progress JourneyProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, code])
  @@map("journey_achievements")
}

/// Weekly reflection answers
model JourneyReflection {
  id          String   @id @default(uuid()) @db.Uuid
  progressId  String   @map("progress_id") @db.Uuid
  week        Int      // 1-4
  bestPart    String?  @map("best_part") @db.Text // What went well
  challenges  String?  @db.Text // What was difficult
  rating      Int?     // 1-5 emoji rating
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  progress JourneyProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, week])
  @@map("journey_reflections")
}

// ============================================
// ZONES MODULE - User-customizable zones
// ============================================

/// User zone (customizable areas of life)
model Zone {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   // "leakfixer", "ai", "poker", "health", "life", "general", or custom
  name      String   // Display name: "LeakFixer", "ИИ", "Покер"
  emoji     String?  // "🔧", "🤖", "♠️"
  color     String?  // Hex color: "#4a5568"
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default") // Can't be deleted
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("zones")
}

// ============================================
// DAILY CHECK-INS - Morning & Evening rituals
// ============================================

/// Daily check-in — morning or evening ritual
/// Morning: set energy, focus, top-3 tasks, intention
/// Evening: rate day, mark wins, reframe if needed
model DailyCheckin {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date
  type   String   // 'morning' | 'evening'

  // Morning fields
  energy    Int?    // 1-10 — predicted energy for the day
  focusWord String? @map("focus_word")  // one word for the day: "продуктивность", "спокойствие"
  task1     String? // top task 1
  task2     String? // top task 2
  task3     String? // top task 3
  intention String? // main thought / reframe for the day

  // Evening fields
  dayRating    Int?    @map("day_rating")    // 1-10 — how the day went
  task1Done    Boolean @default(false) @map("task1_done")
  task2Done    Boolean @default(false) @map("task2_done")
  task3Done    Boolean @default(false) @map("task3_done")
  win          String? // one win of the day (even small)
  reframe      String? // if day was bad — reframe thought
  eveningNote  String? @map("evening_note") // free-form note

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@index([userId, date])
  @@map("daily_checkins")
}
