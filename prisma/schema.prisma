/// Personal challenge (ritual streak, chain completion, custom goal)
model Challenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  // NEW from master
  title       String?   @map("title")        // Short display name (optional, uses name if not set)
  description String?   @map("description")  // Context: why I'm doing this
  type        String    // ritual, chain, custom
  category    String    @default("general") @map("category") // health, money, projects, relationships, learning, lifestyle, career, general
  zone        String    @default("general")
  directionId String?   @map("direction_id") @db.Uuid // Link to Direction (vision)
  chainId     String?   @map("chain_id") @db.Uuid // For chain challenges
  config      String    @default("{}") @map("config") // JSON: ritualIds, targetSteps, targetCount, periodDays, linkedRitualIds, linkedSkillIds, linkedTraitIds, etc.
  duration    Int       @default(30)
  progress    Int       @default(0)
  startDate   DateTime  @default(now()) @map("start_date") @db.Timestamptz
  endDate     DateTime? @map("end_date") @db.Timestamptz
  status      String    @default("active") @map("status") // planned, active, completed, failed
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user            AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction       Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)
  progressDetails ChallengeProgress[]

  @@map("challenges")
}

/// Challenge progress tracking
model ChallengeProgress {
  id            String   @id @default(uuid()) @db.Uuid
  challengeId   String   @map("challenge_id") @db.Uuid
  daysCompleted Int      @default(0) @map("days_completed")
  currentStreak Int      @default(0) @map("current_streak")
  lastCheckedAt DateTime @default(now()) @map("last_checked_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("challenge_progress")
}

