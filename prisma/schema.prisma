/// Supplement definition (vitamin, mineral, etc.)
model Supplement {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   // "Витамин D", "Креатин", "Омега-3"
  dosage       String?  // "2000 ME", "5 г", "1 капсула"
  unit         String   @default("мг") // мг, г, табл, капс, мл
  standardDose Float    @default(1) @map("standard_dose") // Standard dose amount
  timeWindow   String   @default("any") @map("time_window") // morning, day, evening, any
  days         String   @default("[1,2,3,4,5,6,7]") // JSON array of days (1-7)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user    AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  intakes SupplementIntake[]

  @@map("supplements")
}

/// Supplement intake log
model SupplementIntake {
  id           String   @id @default(uuid()) @db.Uuid
  supplementId String   @map("supplement_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @default(now()) @db.Timestamptz
  time         String?  // HH:mm
  dose         Float    @default(1) // Actual dose taken
  checked      Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  supplement Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  user       AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date])
  @@map("supplement_intakes")
}

/// Food entry (meal tracking)
model FoodEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @default(now()) @db.Timestamptz
  mealType  String   @default("snack") @map("meal_type") // breakfast, lunch, dinner, snack
  name      String   // "Овсянка с ягодами"
  time      String?  // "08:30", "12:00" (optional time of meal)
  calories  Int?
  protein   Float?
  fat       Float?
  carbs     Float?
  amount    String?  // "200г", "1 порция"
  quality   String?  // good, neutral, bad (subjective rating)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("food_entries")
}

